# Copy this file to .env (never committed) and set SESSION_SECRET: the server does not start without it.
# The other variables are optional: when they are missing, the defaults below are used.

# Required. Generate your own value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3001
# development by default; tests set test/e2e themselves. Do not set it here: Vite would always build in development mode.
# NODE_ENV=development
TZ=Europe/Rome
# Folder of mountain-hut.db and sessions.db (Docker volume in sprint 2). Relative paths start from the repository root.
DATA_DIR=./server/data
# Fixed "now" in hut local time (YYYY-MM-DDTHH:mm), for demos only. Refused when NODE_ENV=production.
# FAKE_NOW=2026-11-02T10:00

# Client (read by Vite from this same file).
# Only VITE_* variables reach the browser: never prefix secrets (e.g. SESSION_SECRET) with VITE_.
# true = the client answers with mock data, no server needed (demo users in client/src/api/mocks/).
# VITE_USE_MOCKS=true

# Confirmation emails (MH-03). Without SMTP_HOST the email is printed on the server console (development only:
# with NODE_ENV=production the server refuses to start without SMTP_HOST, so emails never get lost silently).
# In tests (NODE_ENV=test or e2e) emails are never sent: they are captured, see GET /api/test/emails.
# For the demo, use a test mailbox (e.g. https://ethereal.email gives free SMTP credentials).
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Mountain Hut <no-reply@mountain-hut.example>
